# MongoDB Atlas: Atlas > Database > Connect > Drivers
# Keep the database name as megamart. URL-encode special characters in passwords.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=megamart

PORT=3000
# Comma-separate local and deployed frontend URLs when needed.
CORS_ORIGIN=http://localhost:5173

token_secret=
smtp_host=
smtp_port=
smtp_mail=
stripe_secret_key=
store_id=
store_passwd=
